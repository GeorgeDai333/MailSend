# Copy to .env for local development. Never commit the real .env.
# On Render these are set as environment variables in the dashboard instead.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_TIME_ZONE=America/Chicago

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Local dev uses SQLite automatically when this is unset.
# Render sets it for you from the managed Postgres instance.
# DATABASE_URL=postgres://user:pass@host:5432/mailsend

# Point at a Render persistent disk in production, or attachments are lost
# every time you deploy.
# DJANGO_MEDIA_ROOT=/var/data/media

# --- Google OAuth (see README) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/google/callback/

# Optional: restrict executive sign-up to specific Google addresses.
# GOOGLE_ALLOWED_EMAILS=boss@company.com,you@company.com
